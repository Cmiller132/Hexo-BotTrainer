# hexfield_eq main_5 architecture — depth scale-up of the live A5 additive
# ray-tap arch (hexfield_eq_raytap_a5_lut2.env): same 192ch D6 regular tie /
# 3 structural heads / v2 features / ray-tap BOTH + additive ray7lut2 / reg
# lane on, trunk deepened 8 -> 15 blocks as the uniform CCA x5 interleave.
# (10, 5) -> CCACCACCACCACCA is already in KNOWN_TRUNK_LAYOUTS (the main_7
# CCAx5 shape), so foreign-arch rebuild inference works without code changes.
# main_5 deltas vs a5_lut2: TRUNK 8->15 blocks; per-cell Q head REMOVED
# (owner ruling 2026-07-22, HEXFIELD_EQ_CELL_Q=0 — an arch knob recorded in
# checkpoint meta; see tests/test_hexfield_eq_cell_q_toggle.py).

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCACCACCACCACCA
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=0

HEXFIELD_EQ_FEATURE_VERSION=2
HEXFIELD_EQ_RAYTAP=both
HEXFIELD_EQ_RAYTAP_LUT=additive

HEXFIELD_EQ_CELL_Q=0
