# hexfield_eq BC-prefit ladder — ARM 4: ray-attention trunk layout
# CCLACCLACLA (5C + 3L + 3A) + the best register-lane configuration from the R
# arms. PLAN_REGISTER_LANE_RAY_ATTENTION.md §3 Phase L2 arm (4).
#
# *** BLOCKED until Phase L1 lands (as of 2026-07-08): constants.py's trunk
# grammar accepts only 'C'/'A' and rejects 'L'; RayAttnBlock / head_perm6 /
# raylen model consumption are in-flight. Run the R arms first (L7 sequencing:
# L phases start only after the register-lane arms have a prefit verdict). ***
#
# Usage (WSL):
#   set -a; source /mnt/e/Hexo-BotTrainer-hexgt/scripts/prefit_env/hexfield_eq_arm4_raylayout.env; set +a
#   PYTHONPATH=/mnt/e/Hexo-BotTrainer-hexgt/packages/hexfield_eq/python \
#     /root/.venvs/hexgt-build/bin/python -m hexfield_eq.prefit \
#     --data /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit_main11 \
#     --out  /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit/arm4_raylayout \
#     --epochs 4 --workers 6 --seed 1
#
# GATE (L2): arm 4 >= best R arm on prefit metrics. KILL: L regresses => stay
# on CCCACCCACCA (layout is env-only).

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCLACCLACLA
# Set these to the R-ladder verdict before launching (default: lane on, read
# per arm-3 outcome).
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=0
