# hexfield_eq ray-tap wave-1 ARM A2 (operator + features) — SPEC_RAYTAP_CONV.md
# §6.3: v2 features (46 planes), ray-tap BOTH (both convs of every C block),
# layout CCLACCLACLA. A2 - A1 = the operator effect on the full layout.

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCLACCLACLA
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=0

# Wave-1 knobs (the A2 deltas: features v2 + ray-tap both).
HEXFIELD_EQ_FEATURE_VERSION=2
HEXFIELD_EQ_RAYTAP=both
