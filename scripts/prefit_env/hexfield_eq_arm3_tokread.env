# hexfield_eq BC-prefit ladder — ARM 3: + REG_TOK_READ (cells <- tokens
# broadcast read at C-block entry, zero-init). PLAN_REGISTER_LANE_RAY_ATTENTION.md
# §3 Phase R1 arm (3). Requires the lane (REG_LANE=1); starts numerically at
# arm 2. Ships only if it beats arm 2.
#
# Usage (WSL):
#   set -a; source /mnt/e/Hexo-BotTrainer-hexgt/scripts/prefit_env/hexfield_eq_arm3_tokread.env; set +a
#   PYTHONPATH=/mnt/e/Hexo-BotTrainer-hexgt/packages/hexfield_eq/python \
#     /root/.venvs/hexgt-build/bin/python -m hexfield_eq.prefit \
#     --data /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit_main11 \
#     --out  /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit/arm3_tokread \
#     --epochs 4 --workers 6 --seed 1

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCCACCCACCA
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=1
