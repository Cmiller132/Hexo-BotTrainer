# hexfield_eq BC-prefit ladder — ARM 1: vanilla equivariant net (the reference
# baseline every later arm must beat). PLAN_REGISTER_LANE_RAY_ATTENTION.md §3
# Phase R1 arm (1); PLAN_D6_EQUIVARIANT_REWRITE.md Phase 4 go/no-go net.
#
# Usage (WSL):
#   set -a; source /mnt/e/Hexo-BotTrainer-hexgt/scripts/prefit_env/hexfield_eq_arm1_vanilla.env; set +a
#   PYTHONPATH=/mnt/e/Hexo-BotTrainer-hexgt/packages/hexfield_eq/python \
#     /root/.venvs/hexgt-build/bin/python -m hexfield_eq.prefit \
#     --data /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit_main11 \
#     --out  /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit/arm1_vanilla \
#     --epochs 4 --workers 6 --seed 1
#
# All arms share --data/--seed (same split, same shuffle streams) so the ladder
# is a controlled A/B; only this env block differs between arms.

# --- D5 width decision (owner, 2026-07-08): C=192 = 12 x C_ORBIT=16; coset
# heads structural at 3 (head_dim = 4*C_ORBIT = 64, kernel fast path).
HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
# Model-side support radius. main_11 (the prefit corpus) was generated at
# radius 4 (its service env), so its policy targets live within radius-4
# support; 4 also matches the live-lineage serve convention. LOAD-BEARING:
# prefit, eval, and serve must all run at the same value.
HEXFIELD_EQ_SUPPORT_RADIUS=4

# --- Arm 1: control trunk, no register lane (T1 baseline layout) ---
HEXFIELD_EQ_TRUNK=CCCACCCACCA
HEXFIELD_EQ_REG_LANE=0
HEXFIELD_EQ_REG_TOK_READ=0

# Prefit uses the eager materialized-bias path by default; torch.compile of the
# forward is on by default (HEXFIELD_PREFIT_COMPILE=1). Uncomment to disable:
# HEXFIELD_PREFIT_COMPILE=0
