# hexfield_eq ray-tap wave-1 ARM A1 (features alone) — SPEC_RAYTAP_CONV.md
# §6.3: v2 features (46 planes), ray-tap OFF, layout CCLACCLACLA. Isolates the
# featurizer change; A2 - A1 = the operator effect.

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCLACCLACLA
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=0

# Wave-1 knobs (the A1 delta: features v2 only).
HEXFIELD_EQ_FEATURE_VERSION=2
HEXFIELD_EQ_RAYTAP=0
