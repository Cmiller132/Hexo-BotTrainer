# hexfield_eq ray-tap wave-1 ARM A0 (control) — SPEC_RAYTAP_CONV.md §6.3.
# Baseline = scripts/prefit_env/hexfield_eq_arm4_raylayout.env (the live-run
# arch env) with the wave's two knobs pinned EXPLICITLY at their defaults:
# v1 features (25 planes), ray-tap off, layout CCLACCLACLA. Every wave-1 arm
# pins the complete arch env; only FEATURE_VERSION / RAYTAP / TRUNK differ
# across arms (a REG_LANE or SUPPORT_RADIUS mismatch would be a confound).

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCLACCLACLA
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=0

# Wave-1 knobs (the A0 deltas: both at default).
HEXFIELD_EQ_FEATURE_VERSION=1
HEXFIELD_EQ_RAYTAP=0
