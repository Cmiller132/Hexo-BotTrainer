# hexfield_eq BC-prefit ladder — ARM 2: + register lane (sigmoid-gated SUM
# token refresh at every C-block exit). PLAN_REGISTER_LANE_RAY_ATTENTION.md §3
# Phase R1 arm (2). Zero-init out_proj => starts numerically at arm 1.
#
# Usage (WSL):
#   set -a; source /mnt/e/Hexo-BotTrainer-hexgt/scripts/prefit_env/hexfield_eq_arm2_reglane.env; set +a
#   PYTHONPATH=/mnt/e/Hexo-BotTrainer-hexgt/packages/hexfield_eq/python \
#     /root/.venvs/hexgt-build/bin/python -m hexfield_eq.prefit \
#     --data /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit_main11 \
#     --out  /mnt/e/Hexo-BotTrainer/runs/hexfield_eq_prefit/arm2_reglane \
#     --epochs 4 --workers 6 --seed 1
#
# GATE (R1): arm 2 >= arm 1 on held-out top-1 AND value_ece; look for the value
# win (calibration by ply bucket). KILL: arm 2 <= arm 1 on both => REG_LANE=0
# and stop the lane arms.

HEXFIELD_EQ_CHANNELS=192
HEXFIELD_EQ_GROUP_ORDER=12
HEXFIELD_EQ_C_ORBIT=16
HEXFIELD_EQ_ATTENTION_HEADS=3
HEXFIELD_EQ_SUPPORT_RADIUS=4

HEXFIELD_EQ_TRUNK=CCCACCCACCA
HEXFIELD_EQ_REG_LANE=1
HEXFIELD_EQ_REG_TOK_READ=0
