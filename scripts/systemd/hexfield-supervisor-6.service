[Unit]
Description=hexfield_main_6 self-play training supervisor (GUMBEL AlphaZero: Top-k root + Sequential Halving + deterministic non-root + completedQ target; flag-gated; c=128; warm-start main_5 ep105; branch claude/hexfield-gumbel)
After=network.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
KillMode=control-group
# main_6 runs the GUMBEL implementation from the worktree E:/Hexo-BotTrainer-gumbel.
# ROOT=worktree => the supervisor's PYTHONPATH prepends the worktree hexfield
# (which carries the freshly-built gumbel _rust.so), shadowing the production
# hexfield in the hexgt-build venv. dense_cnn_restnet resolves from the same
# worktree (identical source; gumbel work never touched it). HEXFIELD_CHANNELS=128
# matches the ep105 c=128 net. Gumbel is enabled via configs/hexfield_main_6.toml
# (Divergences gumbel profile); production()/parity() stay byte-identical.
Environment=ROOT=/mnt/e/Hexo-BotTrainer-gumbel
Environment=RUNDIR=/mnt/e/Hexo-BotTrainer/runs/hexfield_main_6
Environment=CONFIG=/mnt/e/Hexo-BotTrainer-gumbel/configs/hexfield_main_6.toml
Environment=HEXFIELD_SUPPORT_RADIUS=4
Environment=HEXFIELD_TRAIN_FLEX=1
Environment=HEXFIELD_CHANNELS=128
Environment=HEXFIELD_ANCHOR_ROOTS=/mnt/e/Hexo-BotTrainer-hexgt
# Serve-speedup stack (2026-07-02, docs/analysis/MAIN6_SERVE_SPEEDUP_2026-07-02.md):
# fused gather+GEMM triton conv + precomputed-pair flex score_mod + fp16 serve
# copy + Rust parallel pack. ~2.2x serve forward, +63% self-play pos/s at live
# batching. serve-half value parity 4.7e-3 (vs the 3e-3 flex-era gate) accepted
# by the operator 2026-07-02; SealBot multistage eval (every 5 epochs) guards
# strength. Training path untouched by all four flags.
Environment=HEXFIELD_TRITON_CONV=1
Environment=HEXFIELD_FLEX_PAIR=1
Environment=HEXFIELD_SERVE_HALF=1
Environment=HEXFIELD_RUST_PACK=1
# Round-2 speedup (2026-07-03, same doc): pinned copy-stream H2D (submit no
# longer serializes with the GPU), compiled training step (1.30x), glibc
# malloc tunables (allocator churn was ~40% of serve host time).
Environment=HEXFIELD_COPY_STREAM=1
Environment=HEXFIELD_TRAIN_COMPILE=1
Environment=MALLOC_TRIM_THRESHOLD_=536870912
Environment=MALLOC_MMAP_THRESHOLD_=536870912
Environment=MALLOC_TOP_PAD_=134217728
ExecStartPre=/usr/bin/test -f /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
ExecStartPre=-/usr/bin/rm -f /mnt/e/Hexo-BotTrainer/runs/hexfield_main_6/supervisor.lock
ExecStart=/usr/bin/bash /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
RestartPreventExitStatus=1

[Install]
WantedBy=multi-user.target
