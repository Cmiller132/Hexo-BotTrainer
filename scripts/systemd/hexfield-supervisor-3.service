[Unit]
Description=hexfield_main_3 self-play training supervisor (v3: optimizer/heads/search levers; radius-4; main2_ep45 anchor)
After=network.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
KillMode=control-group
# SELF-CONTAINED, version-tracked unit for main_3 (unlike main_2, which split its
# real config across the committed unit + an UNTRACKED scratch/kbuf.conf drop-in).
# Everything the run needs is inline here, so `git`-installing this file is the whole
# deployment. The trainer child (hexo_train.cli.train_model) inherits these.
#
# ROOT  -> the v3 code tree. The committed v3 change-set lives on branch
#          claude/hexfield-main3-v3; the tree at ROOT MUST be checked out to that
#          branch (or have v3 merged to main) before `systemctl start`. The shared
#          supervisor sets PYTHONPATH=$ROOT/packages/hexfield/python:... so hexfield
#          resolves from this tree while hexo_train loads from the venv.
# CONFIG -> the v3 toml (radius-4, +2 conv, cell_q/policy-surprise/adaptive-clip,
#          tspe=48000, games_per_epoch=256, main2_ep45 permanent anchor).
# HEXFIELD_SUPPORT_RADIUS=4 -> model-side legal radius (main_2's radius-4 regime).
# HEXFIELD_ANCHOR_ROOTS -> extra search root so the eval resolves anchors that live
#          only in the canonical tree (main2_ep45 already uses an absolute path, so
#          it resolves regardless; this also covers any run-relative anchors).
Environment=ROOT=/mnt/e/Hexo-BotTrainer-hexgt
Environment=RUNDIR=/mnt/e/Hexo-BotTrainer/runs/hexfield_main_3
Environment=CONFIG=/mnt/e/Hexo-BotTrainer-hexgt/configs/hexfield_main_3.toml
Environment=HEXFIELD_SUPPORT_RADIUS=4
Environment=HEXFIELD_ANCHOR_ROOTS=/mnt/e/Hexo-BotTrainer-hexgt
ExecStartPre=/usr/bin/test -f /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
ExecStartPre=-/usr/bin/rm -f /mnt/e/Hexo-BotTrainer/runs/hexfield_main_3/supervisor.lock
ExecStart=/usr/bin/bash /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
# A clean circuit-breaker halt exits 1; do not let systemd retry it.
RestartPreventExitStatus=1

[Install]
WantedBy=multi-user.target
