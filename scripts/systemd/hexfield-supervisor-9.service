# /etc/systemd/system/hexfield-supervisor-9.service
[Unit]
Description=hexfield_main_9 self-play training supervisor (c=128, heads 2x64, trunk CCACCACCA (9 blocks); HYBRID SEARCH: PUCT full / Gumbel fast, turn-based PCR; KataGo-clean data — no fast-row training; BC-prefit from trimmed main_8 ep7)
After=network.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
KillMode=control-group
# main_9 runs from the DEV repo (carries the fast-row-strip rust .so and the
# 2026-07 triton kernels). Architecture env is LOAD-BEARING — the BC-prefit
# checkpoint is built at the SAME CHANNELS / ATTENTION_HEADS / TRUNK by
# scripts/_main9_prefit_launch.sh, so these must match it exactly.
Environment=ROOT=/mnt/e/Hexo-BotTrainer-hexgt
Environment=RUNDIR=/mnt/e/Hexo-BotTrainer/runs/hexfield_main_9
Environment=CONFIG=/mnt/e/Hexo-BotTrainer-hexgt/configs/hexfield_main_9.toml
Environment=HEXFIELD_SUPPORT_RADIUS=4
Environment=HEXFIELD_CHANNELS=128
Environment=HEXFIELD_ATTENTION_HEADS=2
Environment=HEXFIELD_TRUNK=CCACCACCA
Environment=HEXFIELD_TRAIN_FLEX=1
Environment=HEXFIELD_ANCHOR_ROOTS=/mnt/e/Hexo-BotTrainer-hexgt
# Serve stack (parity-gated in main_6/main_7).
# head_dim is still 64 at c=128/2heads, so the d=64 attn/flex kernels apply.
Environment=HEXFIELD_TRITON_CONV=1
Environment=HEXFIELD_FLEX_PAIR=1
Environment=HEXFIELD_SERVE_HALF=1
Environment=HEXFIELD_RUST_PACK=1
Environment=HEXFIELD_COPY_STREAM=1
Environment=HEXFIELD_TRITON_ATTN=1
Environment=HEXFIELD_TRITON_CONV_LN=1
# fp8 convs measured 4.5e-2 value deviation — OFF pending an arena-eval verdict.
# Environment=HEXFIELD_CONV_FP8=1
Environment=HEXFIELD_TRAIN_COMPILE=1
# Smaller net (c=128) than main_8 — training memory is comfortable; the c=192
# TRAIN_PAIR_BUDGET escape hatch is not needed here.
Environment=MALLOC_TRIM_THRESHOLD_=536870912
Environment=MALLOC_MMAP_THRESHOLD_=536870912
Environment=MALLOC_TOP_PAD_=134217728
ExecStartPre=/usr/bin/test -f /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
ExecStartPre=-/usr/bin/rm -f /mnt/e/Hexo-BotTrainer/runs/hexfield_main_9/supervisor.lock
ExecStart=/usr/bin/bash /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
# A clean circuit-breaker halt exits 1; do not let systemd retry it.
RestartPreventExitStatus=1

[Install]
WantedBy=multi-user.target
