# /etc/systemd/system/hexfield-supervisor-8.service
[Unit]
Description=hexfield_main_8 self-play training supervisor (c=192, heads 3x64, trunk CCAx5; HYBRID SEARCH: PUCT full / Gumbel fast, turn-based PCR; warm-started direct from main_7 ep67)
After=network.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
KillMode=control-group
# main_8 runs from the DEV repo (carries the per-class-divergence rust .so and
# the 2026-07 triton kernels). Architecture env is LOAD-BEARING and IDENTICAL to
# main_7 — the warm-start checkpoint (main_7 ep91) only loads into a net built
# with the same CHANNELS / ATTENTION_HEADS / TRUNK.
Environment=ROOT=/mnt/e/Hexo-BotTrainer-hexgt
Environment=RUNDIR=/mnt/e/Hexo-BotTrainer/runs/hexfield_main_8
Environment=CONFIG=/mnt/e/Hexo-BotTrainer-hexgt/configs/hexfield_main_8.toml
Environment=HEXFIELD_SUPPORT_RADIUS=4
Environment=HEXFIELD_CHANNELS=192
Environment=HEXFIELD_ATTENTION_HEADS=3
Environment=HEXFIELD_TRUNK=CCACCACCACCACCA
Environment=HEXFIELD_TRAIN_FLEX=1
Environment=HEXFIELD_ANCHOR_ROOTS=/mnt/e/Hexo-BotTrainer-hexgt
# Serve stack (parity-gated in main_6/main_7; see PLAN_MAIN7_PERF_ROADMAP.md):
Environment=HEXFIELD_TRITON_CONV=1
Environment=HEXFIELD_FLEX_PAIR=1
Environment=HEXFIELD_SERVE_HALF=1
Environment=HEXFIELD_RUST_PACK=1
Environment=HEXFIELD_COPY_STREAM=1
Environment=HEXFIELD_TRITON_ATTN=1
Environment=HEXFIELD_TRITON_CONV_LN=1
# fp8 convs measured 4.5e-2 value deviation — OFF pending an arena-eval verdict.
# The bring-up prefit window is the slot to A/B this (docs/PLAN_MAIN8 §5.4):
# Environment=HEXFIELD_CONV_FP8=1
Environment=HEXFIELD_TRAIN_COMPILE=1
# Training flex backward memory grows ~1.5x at c=192 — if training OOMs/thrashes:
# Environment=HEXFIELD_TRAIN_PAIR_BUDGET=3e7
Environment=MALLOC_TRIM_THRESHOLD_=536870912
Environment=MALLOC_MMAP_THRESHOLD_=536870912
Environment=MALLOC_TOP_PAD_=134217728
ExecStartPre=/usr/bin/test -f /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
ExecStartPre=-/usr/bin/rm -f /mnt/e/Hexo-BotTrainer/runs/hexfield_main_8/supervisor.lock
ExecStart=/usr/bin/bash /mnt/e/Hexo-BotTrainer-hexgt/scripts/_hexfield_supervise_main1.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
# A clean circuit-breaker halt exits 1; do not let systemd retry it.
RestartPreventExitStatus=1

[Install]
WantedBy=multi-user.target
