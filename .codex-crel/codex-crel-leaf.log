    fn build_universal(
        &mut self,
        state: &mut RustHexoState,
        implicit_dispatch: bool,
        children: &[WidePnChild],
    ) -> Option<CertNodeId> {
        if children
            .first()
            .is_some_and(|child| matches!(child.mv, WidePnMove::DefenderPair(_, _)))
        {
            if !implicit_dispatch
                || children
                    .iter()
