 #[cfg(test)]
+pub(crate) fn begin_pn_init_leaf_state_telemetry() {
+    PN_INIT_TELEMETRY.with(|slot| {
+        *slot.borrow_mut() = Some(PnInitTelemetrySession {
+            capture_states: true,
