            }
            let WidePnMove::One(coord) = child.mv else {
                return None;
            };
            let (_result, delta) = state.apply_with_delta(Placement { coord }).ok()?;
            let proof = self.build(state, self.search.resolved_child_entry(child)?);
            state.undo(delta);
            edges.push(CertEdge {
                mv: coord,
                child: proof?,
            });
