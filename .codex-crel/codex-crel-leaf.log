        Self {
            tt_enabled: true,
            hash_mask: u64::MAX,
            shared_tt: SharedProofCache::new(0, u64::MAX),
            shared_fragments_enabled,
            fragment_store: ProvenFragmentStore::new(0, u64::MAX),
