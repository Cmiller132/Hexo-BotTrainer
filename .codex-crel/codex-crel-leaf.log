fn bytes_of<T>(py: Python<'_>, data: &[T]) -> Py<PyBytes> {
    let byte_len = std::mem::size_of_val(data);
    let bytes = unsafe { std::slice::from_raw_parts(data.as_ptr() as *const u8, byte_len) };
    PyBytes::new(py, bytes).unbind()
}

