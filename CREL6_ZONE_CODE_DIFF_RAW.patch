+fn universal_shapes(cert: &TssCertificate) -> (usize, usize, usize) {
+    let mut total = 0usize;
+    let mut implicit = 0usize;
+    let mut explicit = 0usize;
+    for node in &cert.nodes {
+        if let CertNode::Universal {
+            implicit_dispatch, ..
+        } = node
+        {
+            total += 1;
+            if *implicit_dispatch {
+                implicit += 1;
+            } else {
+                explicit += 1;
+            }
+        }
+    }
+    (total, implicit, explicit)
+}
+
+fn without_zones(cert: &TssCertificate) -> TssCertificate {
+    let mut stripped = cert.clone();
+    for node in &mut stripped.nodes {
+        if let CertNode::Universal { zone, .. } = node {
+            *zone = None;
+        }
+    }
+    stripped
+}
