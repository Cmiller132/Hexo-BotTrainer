+        let mut universal_total = 0usize;
+        let mut implicit_universal_total = 0usize;
+        let mut explicit_universal_total = 0usize;
+        let mut inert_some_strict_accepts = 0usize;
+
+        for (batch_index, batch) in batches.iter().enumerate() {
+            let mut off_solver = make_solver();
+            let mut on_solver = make_solver();
+            for (within_batch, state) in batch.states.iter().enumerate() {
+                let solve_caps = caps(state, horizon);
+
+                std::env::remove_var("TSS_LEAF_ZONED_EMIT");
+                begin_pn_init_leaf_state_telemetry();
+                let off = off_solver.solve_goal(state, &solve_caps, SolveGoal::Win);
+                let off_report =
+                    take_pn_init_telemetry_report().expect("off identity telemetry active");
+                let off_numbers = off_solver.last_wide_root_numbers();
+
+                std::env::set_var("TSS_LEAF_ZONED_EMIT", "1");
+                begin_pn_init_leaf_state_telemetry();
+                let on = on_solver.solve_goal(state, &solve_caps, SolveGoal::Win);
+                let on_report =
+                    take_pn_init_telemetry_report().expect("on identity telemetry active");
+                let on_numbers = on_solver.last_wide_root_numbers();
+                std::env::remove_var("TSS_LEAF_ZONED_EMIT");
+
+                assert_eq!(off.status, on.status, "flag changed root status");
+                assert_eq!(
