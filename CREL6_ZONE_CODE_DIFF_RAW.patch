+#[cfg(test)]
+fn certificate_replay_states(
+    cert: &TssCertificate,
+    root: &RustHexoState,
+) -> Option<Vec<RustHexoState>> {
+    let mut states = vec![None; cert.nodes.len()];
+    let mut stack = vec![(cert.root_node, root.clone())];
+    while let Some((id, state)) = stack.pop() {
+        let slot = states.get_mut(id as usize)?;
+        if let Some(seen) = slot.as_ref() {
+            if PositionKey::from_state(seen) != PositionKey::from_state(&state) {
+                return None;
+            }
+            continue;
+        }
+        *slot = Some(state.clone());
+        match cert.nodes.get(id as usize)? {
+            CertNode::Choice { mv, child } => {
+                let mut next = state;
+                let result = apply_placement(&mut next, Placement { coord: *mv }).ok()?;
+                if result.outcome.is_some() {
+                    return None;
+                }
+                stack.push((*child, next));
+            }
+            CertNode::Universal { edges, .. } => {
+                for edge in edges {
+                    let mut next = state.clone();
+                    let result = apply_placement(&mut next, Placement { coord: edge.mv }).ok()?;
+                    if result.outcome.is_some() {
+                        return None;
+                    }
+                    stack.push((edge.child, next));
+                }
+            }
+            CertNode::OrCompletion { .. } | CertNode::Win { .. } | CertNode::Loss { .. } => {}
+        }
+    }
+    states.into_iter().collect()
+}
+
+#[cfg(test)]
+fn emit_leaf_zones_posthoc(root: &RustHexoState, mut cert: TssCertificate) -> TssCertificate {
+    let Some(states) = certificate_replay_states(&cert, root) else {
+        eprintln!(
+            "LEAF_ZONED_EMIT root_ply={} semantic_horizon={} cert_nodes={} failure=replay_states eligible=0 accepted=0 rebase_rejected=0 strict_rejected=0 final_zoned=0 final_strict=false",
+            root.placements_made(),
+            cert.semantic_horizon,
+            cert.nodes.len(),
+        );
+        return cert;
+    };
+    let eligible = cert
+        .nodes
+        .iter()
+        .zip(&states)
+        .enumerate()
+        .filter_map(|(index, (node, state))| {
+            let CertNode::Universal {
+                edges,
+                implicit_dispatch: false,
+                zone: None,
+                ..
+            } = node
+            else {
+                return None;
+            };
+            let analysis = threats::analyze(state);
+            (!edges.is_empty()
+                && !state.is_terminal()
+                && !matches!(state.phase(), TurnPhase::Opening)
+                && state.current_player() != cert.claimant
+                && !analysis.own_win_now
+                && analysis.min_hitting_set.is_none_or(|k| k < analysis.b))
+            .then_some(index)
+        })
+        .collect::<Vec<_>>();
+
+    let claimed = status_for_claimant(root.current_player(), cert.claimant);
+    let mut accepted = 0usize;
+    let mut rebase_rejected = 0usize;
+    let mut strict_rejected = 0usize;
+    for index in eligible.iter().copied() {
+        let mut candidate = cert.clone();
+        let CertNode::Universal { zone, .. } = &mut candidate.nodes[index] else {
+            unreachable!("eligible index must remain Universal");
+        };
+        *zone = Some(ZoneInfo {
+            d: 0,
+            build_horizon: candidate.semantic_horizon,
+        });
+        if rebase_zone_distances(&mut candidate, root).is_none() {
+            rebase_rejected += 1;
+            continue;
+        }
+        if !TssVerifier.verify(root, &candidate, claimed) {
+            strict_rejected += 1;
+            continue;
+        }
+        cert = candidate;
+        accepted += 1;
+    }
+    let final_zoned = cert
+        .nodes
+        .iter()
+        .filter(|node| matches!(node, CertNode::Universal { zone: Some(_), .. }))
+        .count();
+    let final_strict = TssVerifier.verify(root, &cert, claimed);
+    assert!(
+        accepted == 0 || final_strict,
+        "post-hoc zoned certificate must retain strict acceptance"
+    );
+    eprintln!(
+        "LEAF_ZONED_EMIT root_ply={} semantic_horizon={} cert_nodes={} eligible={} accepted={} rebase_rejected={} strict_rejected={} final_zoned={} final_strict={}",
+        root.placements_made(),
+        cert.semantic_horizon,
+        cert.nodes.len(),
+        eligible.len(),
+        accepted,
+        rebase_rejected,
+        strict_rejected,
+        final_zoned,
+        final_strict,
+    );
+    cert
+}
