+/// R-CREL-6 test-only leaf seam. The wide search and materializer finish
+/// before this flag is inspected. Each candidate annotation is replayed by
+/// the unchanged strict verifier; a rejected annotation is never emitted.
+#[cfg(test)]
+fn leaf_zoned_emit_enabled() -> bool {
+    std::env::var("TSS_LEAF_ZONED_EMIT").ok().as_deref() == Some("1")
+}
