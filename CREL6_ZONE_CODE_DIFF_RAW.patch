+        corpus_path(),
+        eligible_games,
+        batches.len(),
+        batches.len() * WINDOW_STATES,
+    );
+
+    for horizon in HORIZONS {
+        let expected_hard = if horizon == 8 { 16 } else { 39 };
+        let mut roots = 0usize;
+        let mut hard = 0usize;
+        let mut zoned_certificates = 0usize;
+        let mut zoned_node_total = 0usize;
+        let mut strict_zoned = 0usize;
