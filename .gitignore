# One-off analysis probes and their outputs from completed investigations
# (kept locally for reference, not versioned).
scripts/archive/

# Local runtime artifacts.
runs/
*.log
*.out
*.err
*.tmp
*.bak
_tmp_*

# KataGo replay-buffer port: per-phase test scratch holds COPIES of real
# self-play shards (regenerable, never source) + manifests/diags the tests
# write. Never version it.
tests/katago_buffer/_scratch/

# Migration converter (scripts/_hexfield_buffer_convert.py) validation scratch:
# a CPU-only COPY of a few real shards + the manifest/diags it writes during the
# resume+select dry-run. Regenerable, never source.
scratch/

# Model/data outputs.
*.pt
*.pth
*.onnx
*.hxr
*.incomplete
*.watchdog_stopped

data/selfplay/*
data/replay/*
data/checkpoints/*
!data/selfplay/.gitkeep
!data/replay/.gitkeep
!data/checkpoints/.gitkeep


# hexfield bootstrap corpora (regenerable data, not code)
