      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:PYTHONPATH=(('hexo_frontend','hexo_runner') | ForEach-Object { \"E:\\Hexo-BotTrainer-hexgt\\packages\\$_\\python\" }) -join ';'; C:\\Python314\\python.exe -m hexo_frontend.web --host 127.0.0.1 --port 8131"
      ],
