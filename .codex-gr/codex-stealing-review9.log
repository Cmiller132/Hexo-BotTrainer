tactics.rs  458:     /// Update affected windows and return the masks needed for undo.
tactics.rs  459:     pub(crate) fn update_for_placement_with_delta(
tactics.rs  460:         &mut self,
tactics.rs  461:         coord: HexCoord,
tactics.rs  462:         player: Player,
tactics.rs  463:     ) -> (WindowUpdate, WindowStoreDelta) {
tactics.rs  464:         let mut update = WindowUpdate::default();
tactics.rs  465:         let mut delta = WindowStoreDelta::default();
tactics.rs  466: 
tactics.rs  467:         for axis in Axis::ALL {
tactics.rs  468:             for offset in 0..WINDOW_LEN as u8 {
tactics.rs  469:                 let (key, bit) = window_containing(coord, axis, offset);
tactics.rs  470:                 delta
tactics.rs  471:                     .previous_masks
tactics.rs  472:                     .push((key, self.masks_by_key.get(&key).copied()));
tactics.rs  473:                 let masks = self.masks_by_key.entry(key).or_insert([0; 2]);
tactics.rs  474:                 debug_assert_eq!((masks[0] | masks[1]) & bit, 0);
tactics.rs  475:                 masks[player.index()] |= bit;
tactics.rs  476: 
tactics.rs  477:                 let entry = WindowEntry { key, masks: *masks };
tactics.rs  478:                 update.changed.push(key);
tactics.rs  479: 
tactics.rs  480:                 if entry.is_threat_for(player) {
tactics.rs  481:                     update.threats.push(key);
tactics.rs  482:                 }
tactics.rs  483:                 if entry.is_win_for(player) {
tactics.rs  484:                     update.winning_windows.push(key);
tactics.rs  485:                 }
tactics.rs  486: 
tactics.rs  487:                 // Keep the incremental threat index exact: this window's threat
tactics.rs  488:                 // status is fully determined by its new mask, so set-or-clear
tactics.rs  489:                 // unconditionally (idempotent; correct regardless of prior state).
tactics.rs  490:                 match entry.threat_player() {
tactics.rs  491:                     Some(owner) => {
tactics.rs  492:                         self.live_threats.insert(key, owner);
tactics.rs  493:                     }
tactics.rs  494:                     None => {
tactics.rs  495:                         self.live_threats.remove(&key);
tactics.rs  496:                     }
tactics.rs  497:                 }
tactics.rs  498:             }
tactics.rs  499:         }
tactics.rs  500: 
tactics.rs  501:         (update, delta)
tactics.rs  502:     }
tactics.rs  503: 
tactics.rs  504:     pub(crate) fn restore_delta(&mut self, delta: WindowStoreDelta) {
tactics.rs  505:         for (key, previous) in delta.previous_masks.into_iter().rev() {
tactics.rs  506:             if let Some(masks) = previous {
tactics.rs  507:                 self.masks_by_key.insert(key, masks);
tactics.rs  508:                 // Restore the threat index from the restored mask (set-or-clear,
tactics.rs  509:                 // mirroring the forward update above).
tactics.rs  510:                 match (WindowEntry { key, masks }).threat_player() {
tactics.rs  511:                     Some(owner) => {
tactics.rs  512:                         self.live_threats.insert(key, owner);
tactics.rs  513:                     }
tactics.rs  514:                     None => {
tactics.rs  515:                         self.live_threats.remove(&key);
tactics.rs  516:                     }
tactics.rs  517:                 }
tactics.rs  518:             } else {
tactics.rs  519:                 self.masks_by_key.remove(&key);
tactics.rs  520:                 self.live_threats.remove(&key);
tactics.rs  521:             }
tactics.rs  522:         }
tactics.rs  523:     }
tactics.rs  524: }
